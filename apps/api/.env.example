ENVIRONMENT=local
DEBUG=true
PORT=3001
MONGODB_URI=mongodb://localhost:27017/hr_ai_platform?replicaSet=rs0
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Agent runtime (Stage 2). AGENT_MODEL_PROVIDER selects which API key is required at call time —
# only the key for the selected provider needs to be set. See docs/blueprint.md §54 for why
# Vercel AI SDK was chosen. Supported providers: anthropic, openai, deepseek.
AGENT_MODEL_PROVIDER=anthropic
AGENT_MODEL_NAME=claude-3-5-haiku-20241022
AGENT_PROMPT_VERSION=v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
